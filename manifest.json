{
  "manifest_version": 3,
  "name": "Thread Archiver for X",
  "version": "0.3.0",
  "description": "Save an X/Twitter conversation as a single self-contained HTML file with a screenshot of every post.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Archive this conversation",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage", "webRequest"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-thread-archiver@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
